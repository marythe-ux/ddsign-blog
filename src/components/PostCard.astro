---
import { postUrl, formatDate, tagSlug, excerpt, firstImage, getComments, postSlug, type Post } from '../lib/blog';
import CommentIcon from './CommentIcon.astro';
interface Props { post: Post }
const { post } = Astro.props;
const url = postUrl(post);
const img = post.data.image;
const n = getComments(postSlug(post)).length;
---
<article class="postItem">
  <div class="titular"><a href={url}><h2>{post.data.title}</h2></a></div>
  <div class="fecha">
    <time class="entry-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <CommentIcon count={n} href={n > 0 ? `${url}#comentarios` : url} />
  </div>
  {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((t) => <a href={`/tag/${tagSlug(t)}/`}>{t}</a>)}</div>}
  {img && <a class="thumb" href={url} tabindex="-1"><img src={img} alt="" loading="lazy" decoding="async"></a>}
  <div class="entry-content"><p>{excerpt(post)}</p></div>
  <a class="readmore" href={url} aria-label={`Leer «${post.data.title}»`}>+<span></span></a>
</article>
