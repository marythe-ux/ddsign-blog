---
import PostCard from './PostCard.astro';
import type { Post } from '../lib/blog';
interface Props { posts: Post[]; page: number; pages: number }
const { posts, page, pages } = Astro.props;
const href = (n: number) => (n === 1 ? '/' : `/page/${n}/`);
---
{posts.map((p) => <PostCard post={p} />)}
{pages > 1 && (
  <nav class="pagination" aria-label="Paginación">
    <ul>
      {page > 1 && <li><a href={href(page - 1)}>anterior</a></li>}
      {page < pages && <li><a href={href(page + 1)}>siguiente</a></li>}
    </ul>
  </nav>
)}
