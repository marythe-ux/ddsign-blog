---
import { render } from 'astro:content';
import Base from '../../../../layouts/Base.astro';
import CommentIcon from '../../../../components/CommentIcon.astro';
import { getPosts, postParts, postUrl, formatDate, tagSlug, excerpt, firstImage, getComments, postSlug } from '../../../../lib/blog';
export async function getStaticPaths() {
  const all = await getPosts();
  return all.map((post, i) => ({ params: postParts(post), props: { post, newer: all[i - 1], older: all[i + 1] } }));
}
const { post, newer, older } = Astro.props;
const { Content } = await render(post);
const comments = getComments(postSlug(post));
const roots = comments.filter((c) => !c.parent || !comments.some((x) => x.id === c.parent));
const replies = (id: number) => comments.filter((c) => c.parent === id);
const flat: { c: typeof comments[number]; reply: boolean }[] = [];
const walk = (c: typeof comments[number], depth: number) => { flat.push({ c, reply: depth > 0 }); replies(c.id).forEach((r) => walk(r, depth + 1)); };
roots.forEach((c) => walk(c, 0));
const fmt = (s: string) => formatDate(new Date(s + 'Z'));
---
<Base title={post.data.title} description={excerpt(post, 30)} image={firstImage(post)}>
  <article class="postItem">
    <div class="titular"><h1>{post.data.title}</h1></div>
    <div class="fecha">
      <time class="entry-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
      {comments.length > 0 && <CommentIcon count={comments.length} href="#comentarios" />}
    </div>
    {post.data.tags.length > 0 && <div class="tags">{post.data.tags.map((t) => <a href={`/tag/${tagSlug(t)}/`}>{t}</a>)}</div>}
    <div class="entry-content"><Content /></div>

    {flat.length > 0 && (
      <section id="comentarios">
        <h2 class="comments-title"><span class="icon icon-comentarios" aria-hidden="true"></span>{flat.length === 1 ? '1 comentario' : `${flat.length} comentarios`}</h2>
        <p class="comments-note">Comentarios del blog original. Los comentarios están cerrados.</p>
        <ul class="commentlist">
          {flat.map(({ c, reply }) => (
            <li class:list={{ reply }}>
              <div class="comment-meta">
                {c.url ? <a href={c.url} rel="nofollow ugc noopener" target="_blank">{c.author}</a> : <span>{c.author}</span>}
                <time datetime={c.date}>{fmt(c.date)}</time>
              </div>
              {c.text.split('\n\n').map((para) => <p>{para}</p>)}
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>

  <nav class="post-nav" aria-label="Entradas">
    {older ? <a href={postUrl(older)}>← {older.data.title}</a> : <span />}
    {newer ? <a href={postUrl(newer)}>{newer.data.title} →</a> : <span />}
  </nav>
</Base>
