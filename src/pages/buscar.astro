---
import Base from '../layouts/Base.astro';
---
<Base title="Buscar" sidebar={true}>
  <div id="archive-title"><span id="search-heading">Buscar en el blog</span><span class="corners"></span></div>
  <div id="search-results" aria-live="polite"></div>
  <noscript><p class="entry-content">El buscador necesita JavaScript activado.</p></noscript>
  <script is:inline>
    (async function () {
      var params = new URLSearchParams(location.search);
      var q = (params.get('q') || '').trim();
      var input = document.getElementById('s');
      if (input) input.value = q;
      var heading = document.getElementById('search-heading');
      var box = document.getElementById('search-results');
      if (!q) { heading.textContent = 'Escribe arriba lo que quieres buscar'; return; }
      heading.innerHTML = 'Resultados para "<strong></strong>"';
      heading.querySelector('strong').textContent = q;
      box.innerHTML = '<p class="search-status">Buscando…</p>';
      try {
        var base = document.documentElement.dataset.base || '';
        var pagefind = await import(base + '/pagefind/pagefind.js');
        var res = await pagefind.search(q);
        if (!res.results.length) { box.innerHTML = '<p class="search-status">No hay ninguna entrada que coincida. Prueba con otra palabra o mira los <a href="' + base + '/tag/">temas</a>.</p>'; return; }
        var data = await Promise.all(res.results.slice(0, 30).map(function (r) { return r.data(); }));
        box.innerHTML = '';
        var count = document.createElement('p'); count.className = 'search-status';
        count.textContent = res.results.length === 1 ? '1 entrada encontrada' : res.results.length + ' entradas encontradas' + (res.results.length > 30 ? ' (se muestran las 30 más relevantes)' : '');
        box.appendChild(count);
        data.forEach(function (d) {
          var art = document.createElement('article'); art.className = 'postItem';
          var tit = document.createElement('div'); tit.className = 'titular';
          var a = document.createElement('a'); a.href = d.url;
          var h = document.createElement('h2'); h.textContent = (d.meta && d.meta.title) || d.url; a.appendChild(h); tit.appendChild(a);
          art.appendChild(tit);
          if (d.meta && d.meta.date) { var f = document.createElement('div'); f.className = 'fecha'; var t = document.createElement('span'); t.className = 'entry-date'; t.textContent = d.meta.date; f.appendChild(t); art.appendChild(f); }
          var ex = document.createElement('div'); ex.className = 'entry-content'; var p = document.createElement('p'); p.innerHTML = d.excerpt; ex.appendChild(p); art.appendChild(ex);
          var more = document.createElement('a'); more.className = 'readmore'; more.href = d.url; more.setAttribute('aria-label', 'Leer'); more.innerHTML = '+<span></span>'; art.appendChild(more);
          box.appendChild(art);
        });
      } catch (e) {
        box.innerHTML = '<p class="search-status">El buscador no está disponible en este momento.</p>';
      }
    })();
  </script>
</Base>
