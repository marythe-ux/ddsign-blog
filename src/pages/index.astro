---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getPosts, SITE } from '../lib/blog';
const all = await getPosts();
const pages = Math.ceil(all.length / SITE.perPage);
---
<Base current="home">
  <script is:inline>(function(){var q=new URLSearchParams(location.search).get('s');if(q)location.replace('/buscar/?q='+encodeURIComponent(q));})();</script>
  <PostList posts={all.slice(0, SITE.perPage)} page={1} pages={pages} />
</Base>
